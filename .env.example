# PostgreSQL
POSTGRES_USER=kinaudit
POSTGRES_PASSWORD=kinaudit
POSTGRES_DB=kinaudit

# Backend
DATABASE_URL=postgresql+psycopg://kinaudit:kinaudit@postgres:5432/kinaudit
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (browser reaches host-published backend)
# Host port 8001 maps to container port 8000 (see docker-compose.yml).
VITE_API_BASE_URL=http://localhost:8001

# FamilySearch (Phase C — optional live/dev use; never commit real tokens)
FAMILYSEARCH_API_BASE_URL=https://api.familysearch.org
FAMILYSEARCH_CLIENT_ID=
FAMILYSEARCH_REDIRECT_URI=
FAMILYSEARCH_ACCESS_TOKEN=
